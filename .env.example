# DreamKeeper environment variables.
#
# NONE of these are required to run the tests, the mock-mode demos, or
# pnpm demo:native-compat — that's the whole point of `mock` mode. Only set
# variables here for the specific live/real-agent path you want to try.

# --- Live KeeperHub mode (pnpm live:demo / pnpm live:e2e) -------------------
# Set this to switch from mock mode to real KeeperHub execution on Base
# Sepolia. Get one from the KeeperHub dashboard (starts with "kh_").
# If unset, and PRIVATE_KEY below is set instead, DreamKeeper falls back to
# signing directly via viem (OnChainKeeperHubTransport) instead of KeeperHub.
KEEPERHUB_API_KEY=

# Optional. Defaults to https://app.keeperhub.com/mcp if unset.
KEEPERHUB_MCP_URL=

# --- Direct on-chain fallback (used only if KEEPERHUB_API_KEY is unset) ----
# A real hot-wallet private key, held in process memory and used to sign
# transactions directly. Only fund it with what you're willing to expose to
# this process — see docs/THREAT_MODEL.md's Key Management section.
PRIVATE_KEY=

# Optional. Defaults to https://sepolia.base.org if unset.
RPC_URL=

# --- Demo script configuration (optional overrides) -------------------------
# The whitelisted recipient the demo scripts transfer to. Defaults to a
# fixed demo address if unset.
VAULT_ADDRESS=

# ERC-20 token address used by run-demo.ts / test-end-to-end-full.ts in
# --live mode. Defaults to Circle's official Base Sepolia testnet USDC.
USDC_ADDRESS=

# --- Real LLM-driven demo (pnpm demo:real-agent) -----------------------------
# Required only for this one script — every other script/test needs zero
# secrets. Get a free key at https://openrouter.ai — OpenRouter has $0-cost
# models, so a paid account is not required.
OPENROUTER_API_KEY=

# Optional. Defaults to nvidia/nemotron-3-super-120b-a12b:free if unset.
OPENROUTER_MODEL=

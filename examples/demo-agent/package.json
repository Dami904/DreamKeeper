{
  "name": "@dreamkeeper/demo-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Showcase agent running Daydreams with DreamKeeper deterministic execution",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "start": "tsx src/run-demo.ts",
    "demo:firewall": "tsx src/test-firewall.ts",
    "demo:e2e": "tsx src/test-end-to-end-full.ts",
    "demo:real-agent": "tsx --env-file=../../.env src/test-real-agent.ts",
    "demo:attack-scenarios": "tsx --env-file=../../.env src/test-attack-scenarios.ts",
    "demo:native-compat": "tsx src/test-daydreams-integration.ts",
    "test:e2e": "tsx src/test-end-to-end-full.ts",
    "live:demo": "tsx --env-file=../../.env src/run-demo.ts --live",
    "live:e2e": "tsx --env-file=../../.env src/test-end-to-end-full.ts --live",
    "live:real-agent": "tsx --env-file=../../.env src/test-real-agent.ts --live",
    "live:attack-scenarios": "tsx --env-file=../../.env src/test-attack-scenarios.ts --live",
    "live:all-actions": "tsx --env-file=../../.env src/live-all-actions.ts",
    "live:trust-summary": "tsx --env-file=../../.env src/live-trust-summary.ts --live"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "2.0.0",
    "@daydreamsai/core": "^0.3.22",
    "@dreamkeeper/core": "workspace:*",
    "ai": "^5.0.30",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

{
  "name": "dreamkeeper-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Deterministic Execution & Hallucination Firewall for Daydreams Agents via KeeperHub",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --filter @dreamkeeper/core run build && pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "demo:e2e": "pnpm --filter @dreamkeeper/demo-agent run demo:e2e",
    "demo:firewall": "pnpm --filter @dreamkeeper/demo-agent run demo:firewall",
    "live:demo": "pnpm --filter @dreamkeeper/demo-agent run live:demo",
    "live:e2e": "pnpm --filter @dreamkeeper/demo-agent run live:e2e",
    "live:check-balance": "node --env-file=.env scripts/check-balance.mjs",
    "live:check-vault": "node --env-file=.env scripts/check-vault-balance.mjs",
    "live:wallet": "node scripts/create-wallet.mjs",
    "live:vault": "node scripts/create-vault-wallet.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "viem": "^2.56.3",
    "vitest": "^3.0.7"
  }
}

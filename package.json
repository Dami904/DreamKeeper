{
  "name": "dreamkeeper-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Deterministic Execution & Hallucination Firewall for Daydreams Agents via KeeperHub",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "live:demo": "pnpm --filter @dreamkeeper/demo-agent run live:demo"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
